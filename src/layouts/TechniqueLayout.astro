---
// One shape for every technique landing page. The page file carries only copy and
// facts; layout, styling and schema live here so four pages cannot drift.
import BaseLayout from './BaseLayout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import { APP, TECHNIQUES } from '../app';
import { DEFAULT_LOCALE, LOCALES, registeredPath, type Locale, type Slug } from '../site-pages';
import { TECHNIQUE_STRINGS } from './technique-strings';
import { appSchema, articleSchema, breadcrumb, faqSchema } from '../schema';

type TechniqueKey = (typeof TECHNIQUES)[number]['key'];

export interface Section {
  h2: string;
  paras: string[];
  /** First-person block from seo/experience.md, placed inside the section it argues for. */
  aside?: string[];
  table?: { caption: string; head: string[]; rows: string[][] };
}
export interface Step { name: string; seconds?: number; text: string }
export interface Props {
  slug: Slug;
  /** Siblings are resolved in the same locale. */
  locale?: Locale;
  technique: TechniqueKey;
  /** The exact query, used as H1. */
  query: string;
  title: string;
  description: string;
  lede: string;
  /** 40-60 words, self-contained. */
  answer: string;
  sections: Section[];
  howTo: { name: string; description: string; totalTime: string; steps: Step[]; tools?: string[] };
  faqs: { q: string; a: string }[];
  /** Assigned from seo/clusters.md. */
  siblings: { slug: Slug; anchor: string }[];
  sources: { url: string; supports: string }[];
  closeH2: string;
  closeP: string;
  /** Breadcrumb label when the page is not named after its technique. */
  crumb?: string;
  /** Explainer articles: Article schema and a byline instead of the hero CTA and datasheet. */
  article?: { datePublished: string; dateModified: string };
}

const p = Astro.props;
const locale = p.locale ?? DEFAULT_LOCALE;
const lang = LOCALES[locale];
const ui = TECHNIQUE_STRINGS[locale];
const path = registeredPath(p.slug, locale);
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://tryrefresher.app';
const t = TECHNIQUES.find((x) => x.key === p.technique)!;
const crumb = p.crumb ?? t.name;
const accClass = t.access === 'Included' ? 'acc-in' : t.access === 'Premium' ? 'acc-pro' : 'acc-try';

const WORDS_PER_MINUTE = 230;
const proseWords = [
  p.lede, p.answer,
  ...p.sections.flatMap((s) => [s.h2, ...s.paras, ...(s.aside ?? [])]),
  ...p.howTo.steps.flatMap((s) => [s.name, s.text]),
  ...p.faqs.flatMap((f) => [f.q, f.a]),
].join(' ').split(/\s+/).length;
const readingMinutes = Math.ceil(proseWords / WORDS_PER_MINUTE);
const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: p.howTo.name,
  description: p.howTo.description,
  totalTime: p.howTo.totalTime,
  tool: (p.howTo.tools ?? ui.defaultTools).map((name) => ({ '@type': 'HowToTool', name })),
  step: p.howTo.steps.map((s) => ({ '@type': 'HowToStep', name: s.seconds ? `${s.name}, ${s.seconds} ${ui.seconds}` : s.name, text: s.text })),
};
---

<BaseLayout
  title={p.title}
  description={p.description}
  slug={p.slug}
  locale={locale}
  structuredData={[
    ...(p.article ? [articleSchema(site, { headline: p.title, description: p.description, path, inLanguage: lang, ...p.article })] : []),
    appSchema(site), faqSchema(p.faqs, lang), howToSchema, breadcrumb(site, crumb, path, ui.home),
  ]}
>
  <section class="hero container">
    <nav class="crumbs" aria-label={ui.breadcrumbLabel}>
      <a href="/">Refresher</a><span>/</span><span>{crumb}</span>
    </nav>
    <h1>{p.query}</h1>
    {p.article && (
      <p class="byline fine">
        {ui.byline(APP.developer, APP.name)} · <time datetime={p.article.datePublished}>{formatDate(p.article.datePublished)}</time> · {ui.minRead(readingMinutes)}
      </p>
    )}
    <p class="lede">{p.lede}</p>
    <p class="answer">{p.answer}</p>
    {!p.article && (
      <div class="cta">
        <AppStoreBadge />
        <span class="fine">{ui.freeTrial}</span>
      </div>
    )}
  </section>

  <!-- The technique's own datasheet row: pattern, phase bar, access -->
  {!p.article && <section class="sec container">
    <div class="spec">
      <div class="spec-row">
        <span class="lbl">{ui.specTechnique}</span>
        <span class="tname" style={`--c: var(--t-${t.key})`}><em></em>{t.name}</span>
      </div>
      <div class="spec-row">
        <span class="lbl">{ui.specPattern}</span>
        <span class="tpat tnum">{t.pattern}</span>
      </div>
      <div class="spec-row">
        <span class="lbl">{ui.specPhases}</span>
        <span class="ratio" aria-hidden="true">
          {t.ratio.map(([phase, weight]) => (
            <i
              style={`flex:${weight}; background: var(--phase-${String(phase).replace('-soft', '')})`}
              class={String(phase).endsWith('-soft') ? 'soft' : undefined}
            ></i>
          ))}
        </span>
      </div>
      <div class="spec-row">
        <span class="lbl">{ui.specAccess}</span>
        <span class={`acc ${accClass}`}>{ui.access[t.access]}</span>
      </div>
    </div>
  </section>}

  {p.sections.map((s) => (
    <section class="sec container prose-sec">
      <h2>{s.h2}</h2>
      {s.paras.map((para) => <p>{para}</p>)}
      {s.table && (
        <div class="tbl">
          <table>
            <caption>{s.table.caption}</caption>
            <thead><tr>{s.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{s.table.rows.map((row) => <tr>{row.map((c) => <td class="tnum">{c}</td>)}</tr>)}</tbody>
          </table>
        </div>
      )}
      {s.aside && (
        <aside class="note">
          <span class="lbl">{ui.developerOf(APP.developer, APP.name)}</span>
          {s.aside.map((para) => <p>{para}</p>)}
        </aside>
      )}
    </section>
  ))}

  <section class="sec container" id="how">
    <div class="sec-head">
      <span class="lbl">{ui.stepByStep}</span>
      <h2>{p.howTo.name}</h2>
      <p>{p.howTo.description}</p>
    </div>
    <ol class="steps">
      {p.howTo.steps.map((s, i) => (
        <li>
          <span class="step-n tnum">{i + 1}</span>
          <div>
            <b>{s.name}{s.seconds ? <span class="step-s tnum"> · {s.seconds}s</span> : null}</b>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec container" id="faq">
    <div class="sec-head">
      <span class="lbl">{ui.questions}</span>
      <h2>{ui.faqH2}</h2>
    </div>
    <div class="faq">
      {p.faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="sec container related">
    <span class="lbl">{ui.alsoIn}</span>
    <ul>
      {p.siblings.map((s) => <li><a href={registeredPath(s.slug, locale)}>{s.anchor}</a></li>)}
      <li><a href="/">{ui.everyTechnique}</a></li>
    </ul>
  </section>

  {p.sources.length > 0 && (
    <section class="sec container sources">
      <span class="lbl">{ui.sources}</span>
      <ul>
        {p.sources.map((s) => <li><a href={s.url} rel="noopener">{s.url.replace(/^https?:\/\/(www\.)?/, '')}</a> <span>{s.supports}</span></li>)}
      </ul>
    </section>
  )}

  <section class="close">
    <div class="container">
      <h2>{p.closeH2}</h2>
      <p>{p.closeP}</p>
      <AppStoreBadge />
      <div class="fine">{ui.closeFine}</div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-top: var(--space-2xl); max-width: calc(var(--max-width-prose) + 2 * var(--space-lg)); }
  .crumbs { display: flex; gap: 10px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.11em; text-transform: uppercase; color: var(--color-ink-3); margin-bottom: var(--space-lg); }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--color-ink); }
  h1 { font-size: clamp(32px, 4.6vw, 54px); line-height: 1.04; letter-spacing: -0.035em; max-width: 18ch; }
  .lede { margin: var(--space-lg) 0 0; max-width: 54ch; font-size: 16.5px; color: var(--color-ink-2); line-height: 1.62; }
  .answer { margin: var(--space-md) 0 0; max-width: 62ch; font-size: 15px; line-height: 1.68; color: var(--color-ink-2); padding-left: var(--space-md); border-left: 2px solid var(--color-rule); }
  .cta { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: var(--space-xl); }
  .byline { margin: var(--space-md) 0 0; }
  .fine { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.11em; text-transform: uppercase; color: var(--color-ink-3); }

  .spec { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule); border-radius: var(--radius-lg); overflow: hidden; }
  .spec-row { background: var(--color-surface); padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .tname { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-weight: 500; font-size: 14px; }
  .tname em { width: 3px; height: 18px; border-radius: 2px; background: var(--c); }
  .tpat { font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.06em; color: var(--color-ink-2); }
  .ratio { display: flex; gap: 2px; height: 8px; margin-top: 4px; }
  .ratio i { display: block; border-radius: 1px; height: 100%; }
  .ratio i.soft { opacity: 0.5; }
  .acc { align-self: flex-start; }

  .prose-sec, .related, .sources, #how, #faq { max-width: calc(var(--max-width-prose) + 2 * var(--space-lg)); }
  .prose-sec h2 { font-size: clamp(22px, 2.8vw, 30px); margin: 0 0 14px; max-width: 26ch; }
  .prose-sec p { margin: 0 0 14px; max-width: 66ch; color: var(--color-ink-2); font-size: 15.5px; line-height: 1.66; }
  .prose-sec p:last-child { margin-bottom: 0; }

  .tbl { margin: 4px 0 18px; overflow-x: auto; border: 1px solid var(--color-rule); border-radius: var(--radius-lg); }
  .tbl table { width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 13px; }
  .tbl caption { caption-side: bottom; text-align: left; padding: 10px 16px; font-size: 12px; color: var(--color-ink-3); }
  .tbl th, .tbl td { padding: 10px 16px; text-align: left; vertical-align: bottom; border-bottom: 1px solid var(--color-rule); }
  .tbl th { font-weight: 500; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-3); background: var(--color-surface); }
  .tbl td { color: var(--color-ink-2); white-space: nowrap; }
  .tbl tbody tr:last-child td { border-bottom: 0; }

  .note { margin-top: var(--space-lg); border: 1px solid var(--color-rule); border-left: 3px solid var(--color-brand); border-radius: var(--radius-lg); background: var(--color-surface); padding: 18px 22px 20px; }
  .note p { margin: 10px 0 0; max-width: 70ch; font-size: 14.5px; line-height: 1.62; color: var(--color-ink-2); }

  .steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule); border-radius: var(--radius-lg); overflow: hidden; }
  .steps li { display: flex; gap: 18px; padding: 16px 20px; background: var(--color-surface); }
  .step-n { flex: 0 0 auto; font-family: var(--font-mono); font-size: 12px; color: var(--color-ink-3); padding-top: 3px; }
  .steps b { display: block; font-weight: 600; font-size: 15px; }
  .step-s { font-family: var(--font-mono); font-weight: 400; color: var(--color-ink-3); font-size: 12.5px; }
  .steps p { margin: 5px 0 0; font-size: 14px; color: var(--color-ink-2); line-height: 1.55; max-width: 62ch; }

  .related ul, .sources ul { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .related a { font-size: 15px; }
  .sources li { font-size: 13px; color: var(--color-ink-3); line-height: 1.5; }
  .sources a { font-family: var(--font-mono); font-size: 12.5px; word-break: break-all; }

  .close { margin-top: var(--space-3xl); padding: var(--space-3xl) 0; border-top: 1px solid var(--color-rule); text-align: center; }
  .close h2 { font-size: clamp(26px, 3.6vw, 42px); margin-bottom: 14px; }
  .close p { margin: 0 auto var(--space-lg); max-width: 46ch; color: var(--color-ink-2); font-size: 15.5px; }
  .close .fine { margin-top: 18px; }

  @media (max-width: 700px) {
    .spec { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tbl th, .tbl td { padding: 10px 12px; }
  }
</style>
