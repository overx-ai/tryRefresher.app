---
// Shared SEO shell. Everything renders to static HTML at build time — no
// hydration, no client JS, nothing a crawler has to wait for.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pathFor } from '../site-pages';
import { APP } from '../app';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** Route key, registered in src/site-pages.ts. '' for home. */
  slug?: string;
  ogImage?: string;
  structuredData?: object[];
  noindex?: boolean;
}

const {
  title,
  description,
  slug = '',
  ogImage = '/og-image.jpg',
  structuredData = [],
  noindex = false,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://tryrefresher.app';
const canonicalURL = `${site}${pathFor(slug)}`;
const fullTitle = title.includes(APP.name) ? title : `${title} | ${APP.name}`;
const indexable = !noindex;

// WebSite schema on the home page only, per Google guidance.
const websiteSchema =
  slug === '' && indexable
    ? [{
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: APP.name,
        url: `${site}/`,
        inLanguage: 'en-US',
      }]
    : [];
const allStructuredData = [...websiteSchema, ...structuredData];
---

<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
  {indexable && <link rel="canonical" href={canonicalURL} />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={APP.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={`${site}${ogImage}`} />
  <!-- Dimensions match public/og-image.jpg. Change both together. -->
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="675" />
  <meta property="og:image:alt" content="Refresher, a breathing pacer accurate to the second" />
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${site}${ogImage}`} />

  <!-- Smart App Banner: turns an iOS Safari visit into a one-tap install. -->
  <meta name="apple-itunes-app" content={`app-id=${APP.appStoreId}`} />

  <!--
    Raster icons only. No favicon.svg: an image/svg+xml icon wins over PNG in
    every browser that supports it, so a stale SVG would silently override
    everything else no matter what we ship.
  -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <!-- Both, so the browser paints the right chrome before CSS resolves. -->
  <meta name="theme-color" content="#f5f7fa" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" />

  {allStructuredData.map((entry) => (
    <script type="application/ld+json" set:html={JSON.stringify(entry)} />
  ))}
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <Header slug={slug} />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
