---
import BaseLayout from '../layouts/BaseLayout.astro';

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://tryrefresher.app';

// Mirrors the roadmap-api `shipped` ideas for the refresher tenant. Add a row when an idea is
// marked shipped there; the votes are the count at the moment it shipped.
const shipped = [
  {
    title: 'A quick quiz to find your technique',
    shippedIn: 'October 2026',
    votes: 3,
    body: 'Two questions: what you need right now (stressed, can\'t sleep, can\'t focus, tired, irritated, or fine) and whether you have 1, 3 or 5 minutes. Refresher picks a technique and sets that session to the time you chose. Ask again and it offers a different one.',
  },
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Community', item: `${site}/community` },
  ],
};
---
<BaseLayout
  title="Built with the community"
  description="What Refresher users asked for, voted on, and got. The in-app roadmap is open to every user, and the ideas that ship are listed here."
  slug="community"
  structuredData={[breadcrumb]}
>
  <div class="container community">
    <span class="lbl">Community</span>
    <h1>You vote on what we <span class="go">build next.</span></h1>
    <div class="stats">
      <span class="pill solid">{shipped.length} shipped</span>
      <span class="pill">{shipped.reduce((sum, item) => sum + item.votes, 0)} votes counted</span>
      <span class="pill">Open to every user</span>
    </div>

    <section class="block">
      <p class="lead">
        Refresher has a public roadmap inside the app. Anyone can suggest an idea, every user
        gets one vote per idea, and the order of the list is the order of the votes. When an idea
        ships, it's marked Shipped there and listed on this page.
      </p>
    </section>

    <section class="block">
      <h2>Shipped</h2>
      <ol class="shipped">
        {shipped.map((item) => (
          <li>
            <div class="meta">
              <span class="pill solid"><b aria-hidden="true">✓</b> Shipped</span>
              <span class="pill"><span aria-hidden="true">▲</span> {item.votes} {item.votes === 1 ? 'vote' : 'votes'}</span>
              <span class="date">{item.shippedIn}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="block suggest">
      <h2>Suggest the next one</h2>
      <p>
        Open Refresher, tap the people icon at the top of the Breathe screen, then the map icon for the Roadmap. Vote
        for what you want, or tap Suggest an idea. New ideas show up after a quick review. Votes
        are tied to an anonymous ID, not an account.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* The app's Hold green, already defined per theme in global.css. */
  .community { --ship: var(--phase-hold); padding-block: var(--space-2xl); max-width: 760px; }
  .community h1 { margin: var(--space-sm) 0 var(--space-md); }
  .go { color: var(--ship); }
  .stats { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-xl); }
  .block { margin-bottom: var(--space-2xl); }
  .block h2 { margin-bottom: var(--space-md); }
  .lead { font-size: 1.125rem; color: var(--color-ink-2); }
  .pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--ship) 45%, transparent);
    background: color-mix(in srgb, var(--ship) 12%, transparent);
    /* Pure --phase-hold is ~3:1 on the light background, under AA for 11px text. */
    color: color-mix(in srgb, var(--ship) 60%, var(--color-ink));
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pill.solid { background: var(--ship); border-color: var(--ship); color: #06210f; }
  .pill b { font-weight: 700; }
  .shipped { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-md); }
  .shipped li {
    border: 1px solid color-mix(in srgb, var(--ship) 35%, var(--color-rule));
    border-left: 4px solid var(--ship);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, color-mix(in srgb, var(--ship) 10%, transparent), transparent 60%);
    padding: var(--space-lg);
  }
  .shipped h3 { margin: var(--space-sm) 0; }
  .shipped p { margin: 0; color: var(--color-ink-2); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); }
  .date {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .suggest {
    border: 1px dashed color-mix(in srgb, var(--ship) 55%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }
  .suggest h2 { margin-top: 0; color: var(--ship); }
  .suggest p { margin-bottom: 0; }
</style>
