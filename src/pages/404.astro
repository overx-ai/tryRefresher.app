---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <div class="container nf">
    <span class="lbl">Error 404</span>
    <h1>That page does not exist.</h1>
    <p>The link may be out of date, or the page may have moved.</p>
    <div class="links">
      <a href="/">Home</a>
      <a href="/support">Support</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </div>
  </div>
</BaseLayout>

<style>
  .nf { padding-block: var(--space-3xl); max-width: 60ch; }
  h1 { font-size: clamp(28px, 4vw, 42px); margin: 10px 0 var(--space-md); }
  p { color: var(--color-ink-2); margin: 0 0 var(--space-xl); }
  .links { display: flex; gap: 20px; flex-wrap: wrap; }
  .links a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 3px;
  }
  .links a:hover { color: var(--color-ink); border-bottom-color: var(--color-brand); }
</style>
