---
import { APP } from '../app';
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="container foot-in">
    <nav aria-label="Footer">
      <a href="/support">Support</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/press">Press</a>
    </nav>
    <span class="sp"></span>
    <span class="note">Refresher is not a medical device.</span>
  </div>
  <div class="container foot-legal">
    <span>&copy; {year} {APP.developer}</span>
    <a href={APP.publisherUrl} rel="noopener">{APP.publisher}</a>
    <a href={`mailto:${APP.supportEmail}`}>{APP.supportEmail}</a>
  </div>
</footer>

<style>
  .site-foot { border-top: 1px solid var(--color-rule); margin-top: var(--space-3xl); }
  .foot-in {
    display: flex; gap: 22px; flex-wrap: wrap; align-items: center;
    padding-block: var(--space-lg);
  }
  .foot-in nav { display: flex; gap: 22px; flex-wrap: wrap; }
  .sp { flex: 1; }
  a, .note, .foot-legal span, .foot-legal a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    text-decoration: none;
  }
  .foot-in nav a:hover, .foot-legal a:hover { color: var(--color-ink); }
  .foot-legal {
    display: flex; gap: 22px; flex-wrap: wrap;
    padding-bottom: var(--space-2xl);
    border-top: 1px solid var(--color-rule-soft);
    padding-top: var(--space-md);
  }
  .foot-legal span, .foot-legal a { letter-spacing: 0.06em; text-transform: none; }
</style>
