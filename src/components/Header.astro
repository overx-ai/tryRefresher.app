---
import Orb from './Orb.astro';
import { APP } from '../app';
export interface Props { slug?: string }
const { slug = '' } = Astro.props;
const nav = [
  { key: 'techniques', href: '/#techniques', label: 'Techniques' },
  { key: 'evidence', href: '/#evidence', label: 'Evidence' },
  { key: 'support', href: '/support', label: 'Support' },
];
---
<header class="site-nav">
  <div class="container nav-in">
    <a class="mark" href="/">
      <Orb size="26px" />
      <span class="wm">{APP.name}</span>
    </a>
    <span class="sub">Breathing &amp; HRV</span>
    <span class="sp"></span>
    <nav aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={n.key === slug ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-rule);
  }
  .nav-in { display: flex; align-items: center; gap: 14px; padding-block: 13px; flex-wrap: wrap; row-gap: 10px; }
  .mark { display: flex; align-items: center; gap: 11px; text-decoration: none; }
  .wm { font-family: var(--font-display); font-size: 16px; font-weight: 700; letter-spacing: -0.02em; }
  .sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .sp { flex: 1; }
  nav { display: flex; gap: 20px; }
  nav a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  nav a:hover, nav a[aria-current='page'] { color: var(--color-ink); }
  @media (max-width: 720px) {
    .sub { display: none; }
    nav { gap: 16px; }
  }
  /* Below ~420px the wordmark plus three links exceed the viewport. Let the
     links take their own row rather than widen the page. */
  @media (max-width: 420px) {
    .sp { flex-basis: 100%; height: 0; }
    nav { width: 100%; justify-content: space-between; gap: 10px; }
  }
</style>
